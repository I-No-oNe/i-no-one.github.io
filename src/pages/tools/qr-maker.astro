---
import ToolsLayout from '../../layouts/ToolsLayout.astro';
import Icon from '../../components/Icon.astro';
import '../../../tools/qr-maker/styles.css';
import logic from '../../../tools/qr-maker/script.js?url';
---

<ToolsLayout active="qr" title="QR code maker" description="Generate and download a clean QR code from text or a URL.">
  <section class="qr-studio tool-app-card">
    <div class="qr-compose">
      <div class="qr-compose-copy">
        <p class="qr-eyebrow">Create</p>
        <h2>What should it open?</h2>
        <p>Paste a link or write a short message. You can replace it anytime.</p>
      </div>
      <label class="qr-label" for="text">Text or URL</label>
      <div class="input-section">
        <input type="text" id="text" class="field" placeholder="https://example.com" autocomplete="off" />
        <button class="btn btn-primary" type="button" onclick="generateQR()">Generate QR</button>
      </div>
      <p class="privacy-note"><Icon name="lock" size={14} /> Generated in your browser. Nothing is uploaded.</p>
    </div>
    <div class="qr-preview" id="qr-preview">
      <div class="qr-empty" id="qr-empty">
        <span class="qr-empty-icon"><Icon name="qr" size={30} /></span>
        <h3>Your preview appears here</h3>
        <p>Enter something first, then generate a ready-to-download QR code.</p>
      </div>
      <div class="loading-spinner" id="spinner" aria-label="Generating QR code"></div>
      <div id="qrcode" class="qrcode" aria-live="polite"></div>
      <button id="downloadBtn" class="btn qr-download" type="button" onclick="downloadQR()" hidden><Icon name="download" size={16} /> Download PNG</button>
    </div>
  </section>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
  <script is:inline src={logic} defer></script>
</ToolsLayout>
