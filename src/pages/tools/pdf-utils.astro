---
import ToolsLayout from '../../layouts/ToolsLayout.astro';
import Icon from '../../components/Icon.astro';
import styles from '../../../tools/pdf-utils/style.css?url';
import logic from '../../../tools/pdf-utils/script.js?url';
---

<ToolsLayout active="pdf" title="PDF utils" description="Convert, merge, split, and OCR documents locally in your browser." stylesheets={[styles]}>
  <div class="wrap pdf-app">
    <div class="tabs" role="tablist" aria-label="PDF operations">
      <button class="tab active" type="button" role="tab" aria-selected="true" tabindex="0" data-tab="convertTab">Convert</button>
      <button class="tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="mergeTab">Merge</button>
      <button class="tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="htmlTab">HTML</button>
      <button class="tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="splitTab">Split</button>
      <button class="tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="ocrTab">OCR</button>
    </div>
    <div class="pdf-workspace">
    <div class="pdf-operation-stack">

    <div class="tab-content active" id="convertTab">
      <div class="card">
        <div class="card-title"><span class="dot"></span>Files to convert</div>
        <div class="drop-zone" id="dzConvert"><span class="drop-icon"><Icon name="file" size={29} /></span><div class="drop-text">Drop images or documents here</div><div class="drop-hint">or <a href="#" id="brConvert">browse files</a> · JPG PNG GIF TXT DOCX</div></div>
        <input type="file" id="fiConvert" accept=".jpg,.jpeg,.png,.gif,.txt,.docx,.doc" multiple />
        <div class="file-list" id="flConvert"></div>
        <div class="stats" id="stConvert" style="display:none;"><span>Files: <strong id="cnConvert">0</strong></span><span>Size: <strong id="szConvert">0 KB</strong></span><button class="clear-btn" id="btnClearConvert" disabled>Clear all</button></div>
        <div class="controls">
          <div class="cg"><label for="psConvert">Page size</label><select id="psConvert"><option value="a4">A4</option><option value="letter">Letter</option><option value="legal">Legal</option></select></div>
          <div class="cg"><label for="orConvert">Orientation</label><select id="orConvert"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></div>
          <div class="cg"><label for="quConvert">Quality</label><select id="quConvert"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></div>
          <button id="btnConvert" class="btn-p" disabled>Convert to PDF</button>
        </div>
        <div class="processing" id="procConvert"><div class="spinner"></div><span>Converting files…</span></div>
      </div>
    </div>

    <div class="tab-content" id="mergeTab">
      <div class="card">
        <div class="card-title"><span class="dot"></span>PDFs to merge <small>drag to reorder</small></div>
        <div class="drop-zone" id="dzMerge"><span class="drop-icon"><Icon name="file" size={29} /></span><div class="drop-text">Drop PDF files here</div><div class="drop-hint">or <a href="#" id="brMerge">browse files</a></div></div>
        <input id="fiMerge" type="file" multiple accept=".pdf,application/pdf" />
        <div class="file-list" id="flMerge"></div>
        <div class="stats" id="stMerge" style="display:none;"><span>PDFs: <strong id="cnMerge">0</strong></span><span>Pages: <strong id="pgMerge">0</strong></span><span>Size: <strong id="szMerge">0 KB</strong></span><button class="clear-btn" id="btnClearMerge" disabled>Clear all</button></div>
        <div class="controls"><button id="btnMerge" class="btn-p" disabled>Merge PDFs</button></div>
        <div class="processing" id="procMerge"><div class="spinner"></div><span>Merging PDFs…</span></div>
      </div>
    </div>

    <div class="tab-content" id="htmlTab">
      <div class="card">
        <div class="card-title"><span class="dot"></span>HTML to PDF</div>
        <label class="sr-only" for="htmlInput">HTML source</label><textarea id="htmlInput" rows="12" placeholder="Paste your HTML here…"></textarea>
        <div class="controls">
          <div class="cg"><label for="psHtml">Page size</label><select id="psHtml"><option value="a4">A4</option><option value="letter">Letter</option></select></div>
          <div class="cg"><label for="orHtml">Orientation</label><select id="orHtml"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></div>
          <div class="cg"><label for="mgHtml">Margin (mm)</label><input type="number" id="mgHtml" value="10" min="0" max="50" /></div>
          <button id="btnClearHtml" class="btn-s">Clear</button><button id="btnHtmlPdf" class="btn-p">Convert HTML</button>
        </div>
        <div class="processing" id="procHtml"><div class="spinner"></div><span>Converting HTML…</span></div>
      </div>
    </div>

    <div class="tab-content" id="splitTab">
      <div class="card">
        <div class="card-title"><span class="dot"></span>Split PDF</div>
        <div class="drop-zone" id="dzSplit"><span class="drop-icon"><Icon name="file" size={29} /></span><div class="drop-text">Drop one PDF here</div><div class="drop-hint">or <a href="#" id="brSplit">browse file</a></div></div>
        <input type="file" id="fiSplit" accept=".pdf" />
        <div id="splitControls" class="split-inner" style="display:none;">
          <div class="controls"><div class="cg split-method"><label for="splitMethod">Split method</label><select id="splitMethod"><option value="range">Extract range</option><option value="pages">Specific pages</option><option value="every">Every N pages</option></select></div></div>
          <div class="ic" id="rangeInput"><label for="pageRange">Page range</label><input type="text" id="pageRange" placeholder="e.g. 1-5 or 1-3, 7-9" /></div>
          <div class="ic" id="pagesInput" style="display:none;"><label for="specificPages">Specific pages</label><input type="text" id="specificPages" placeholder="e.g. 2, 4, 7" /></div>
          <div class="ic" id="everyInput" style="display:none;"><label for="everyPages">Pages per file</label><input type="number" id="everyPages" value="5" min="1" /></div>
          <div class="controls"><button id="btnSplit" class="btn-p" disabled>Split PDF</button></div>
        </div>
        <div class="processing" id="procSplit"><div class="spinner"></div><span>Splitting PDF…</span></div>
      </div>
    </div>

    <div class="tab-content" id="ocrTab">
      <div class="card">
        <div class="card-title"><span class="dot"></span>Extract text with OCR</div>
        <div class="drop-zone" id="dzOcr"><span class="drop-icon"><Icon name="file" size={29} /></span><div class="drop-text">Drop a PDF or image here</div><div class="drop-hint">or <a href="#" id="brOcr">browse file</a> · PDF JPG PNG BMP TIFF</div></div>
        <input type="file" id="fiOcr" accept=".pdf,.jpg,.jpeg,.png,.gif,.bmp,.tiff,.tif,image/*,application/pdf" />
        <div class="controls">
          <div class="cg"><label for="ocrFmt">Output</label><select id="ocrFmt"><option value="text">Plain text</option><option value="hocr">hOCR (HTML)</option></select></div>
          <div class="cg"><label for="ocrPages">PDF pages</label><input type="text" id="ocrPages" value="all" /></div>
          <div class="cg"><label for="ocrScale">Render scale</label><select id="ocrScale"><option value="2">2× faster</option><option value="3" selected>3× balanced</option><option value="4">4× sharper</option></select></div>
          <div class="cg"><label for="ocrPSM">Layout</label><select id="ocrPSM"><option value="3">Auto</option><option value="6">Single block</option><option value="11">Sparse text</option><option value="4">Single column</option></select></div>
        </div>
        <div class="cg language-control"><label>Languages</label><div class="lang-grid" id="langGrid"></div></div>
        <div class="controls"><button id="btnOcr" class="btn-p" disabled>Run OCR</button><button id="btnOcrClear" class="btn-s">Clear</button></div>
        <div class="ocr-prog-wrap" id="ocrProgWrap"><div class="ocr-prog" id="ocrProg"></div></div><div class="ocr-status" id="ocrStatus"></div>
        <div id="ocrOutputWrap" style="display:none;">
          <div class="ocr-toolbar"><span class="ocr-toolbar-label">Extracted text</span><div class="ocr-toolbar-actions"><span class="pill" id="ocrWords"><strong>0</strong>&nbsp;words</span><span class="conf-badge" id="ocrConf"></span><button class="btn-s btn-xs" id="btnOcrCopy">Copy</button><button class="btn-s btn-xs" id="btnOcrTxt">Save .txt</button></div></div>
          <label class="sr-only" for="ocrText">Extracted text</label><textarea id="ocrText" readonly placeholder="Extracted text appears here…"></textarea>
        </div>
        <div class="processing" id="procOcr"><div class="spinner"></div><span id="procOcrLabel">Preparing…</span></div>
      </div>
    </div>
    </div>

    <div class="card preview-card">
      <div class="preview-header"><div class="card-title"><span class="dot"></span>Preview</div><div class="preview-actions"><div class="preview-info"><span class="status-dot" id="statusDot"></span><span id="previewInfo">No document loaded</span></div><button id="btnDownload" class="btn-s" style="display:none;">Download</button></div></div>
      <div id="previewFrame"><div class="empty-preview"><span class="icon"><Icon name="file" size={32} /></span><strong>Preview ready</strong><p>Your converted PDF appears here.</p></div></div>
    </div>
    </div>
  </div>
  <script is:inline src={logic} defer></script>
</ToolsLayout>
