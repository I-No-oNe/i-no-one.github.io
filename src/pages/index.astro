---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ActionButton from '../components/ActionButton.astro';
import GlassPanel from '../components/GlassPanel.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/avatar.png';
import { githubFields, modrinthFields, projectList, renderProjects } from '../../site/projects.js';

async function fetchJson(url: string) {
  const response = await fetch(url, { signal: AbortSignal.timeout(8000) });
  if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
  return response.json();
}

const [repos, modrinthProjects] = await Promise.all([
  fetchJson('https://api.github.com/users/I-No-oNe/repos?per_page=100')
    .then((list) => list.map(githubFields))
    .catch((error: Error) => { console.warn('[build] GitHub projects unavailable:', error.message); return []; }),
  fetchJson('https://api.modrinth.com/v2/user/iwsGxbBt/projects')
    .then((list) => list.map(modrinthFields))
    .catch((error: Error) => { console.warn('[build] Modrinth projects unavailable:', error.message); return []; })
]);
const projectData = { github: repos, modrinth: modrinthProjects };
const projects = projectList(repos, modrinthProjects);

---

<BaseLayout title="I-No-oNe" description="I-No-oNe - Minecraft mod developer, maker of web tools and FRC gadgets. Open source on GitHub and Modrinth.">
  <Fragment slot="head"><link rel="preconnect" href="https://api.github.com" crossorigin /><link rel="preconnect" href="https://api.modrinth.com" crossorigin /></Fragment>
  <SiteHeader />
  <main id="top">
    <section id="home" class="hero"><div class="container"><GlassPanel class="profile-card hero-panel">
      <div class="profile-glow" aria-hidden="true"></div>
      <div class="avatar-wrap"><Image src={avatar} alt="I-No-oNe avatar" class="profile-avatar" width={152} height={152} densities={[1, 2]} loading="eager" fetchpriority="high" decoding="async" /></div>
      <div class="profile-info"><div class="badges"><StatusBadge live>Heads-down on private work</StatusBadge><StatusBadge>Free time: personal software &amp; mods</StatusBadge></div><h1>I-No-oNe</h1><p class="tagline">Mod developer &amp; maker. I build Minecraft mods, handy web tools, and FRC gadgets - all open source on GitHub and Modrinth.</p><div class="cta"><ActionButton href="#projects" variant="primary">Explore projects <Icon name="arrow" size={16} /></ActionButton><ActionButton href="/tools/">Open tools <Icon name="grid" size={16} /></ActionButton></div></div>
    </GlassPanel></div></section>
    <div class="container">
      <GlassPanel as="section" id="projects" class="card"><SectionHeader title="Projects" subtitle="Start with the projects people use most." href="https://github.com/I-No-oNe?tab=repositories" linkLabel="Browse all repos" /><p class="project-source-note">Downloads on Modrinth · Stars on GitHub</p>
      <div id="repos" class="repos-grid" role="region" aria-label="Projects, most popular first" aria-busy={repos.length ? 'false' : 'true'}>
        {repos.length ? <Fragment set:html={renderProjects(projects)} /> : <p class="muted">Loading projects…</p>}
      </div></GlassPanel>
      <div class="two-col">
        <GlassPanel as="section" id="frc" class="card" reveal delay={80}><SectionHeader title="FRC" /><p>The FIRST® Robotics Competition stages short games played by robots - designed and built by high-school teams and engineer mentors, then driven in live competition.</p><ActionButton href="/counter/" variant="primary">Season countdown <Icon name="arrow" size={16} /></ActionButton></GlassPanel>
        <GlassPanel as="section" id="tools" class="card" reveal delay={140}><SectionHeader title="Tools" /><p>A small collection of web tools I actually use - QR maker, PDF utils, obfuscator, server checker and more.</p><ActionButton href="/tools/" variant="primary">Open tools <Icon name="arrow" size={16} /></ActionButton></GlassPanel>
      </div>
      <GlassPanel as="section" id="contact" class="card contact-card" reveal><div><h2>Let's build something</h2><p class="muted">Got a question, a bug, or an idea? Reach out.</p></div><div class="cta"><ActionButton href="https://discord.com/users/1051897115447660697" variant="primary" external>Message on Discord</ActionButton><ActionButton href="https://discord.gg/QHFSDPajd6" external>Join server</ActionButton></div></GlassPanel>
    </div>
  </main>
  <PageFooter />
  <script id="project-data" type="application/json" is:inline set:html={JSON.stringify(projectData).replace(/</g, '\\u003c')}></script>
  <script>import '../../site/script.js';</script>
</BaseLayout>
