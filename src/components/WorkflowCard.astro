---
import Icon from './Icon.astro';

interface Props { title: string; code: string; }
const { title, code } = Astro.props as Props;
---

<details class="workflow-card">
  <summary><span class="workflow-title"><span class="workflow-icon"><Icon name="code" size={17} /></span><span>{title}<small>GitHub Actions</small></span></span><span class="workflow-plus" aria-hidden="true"></span></summary>
  <div class="workflow-content"><div class="workflow-content-inner"><pre><code>{code}</code></pre></div></div>
</details>
