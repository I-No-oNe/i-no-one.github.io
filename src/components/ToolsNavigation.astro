---
import ThemeToggle from './ThemeToggle.astro';
import ToolNavItem from './ToolNavItem.astro';
import Icon from './Icon.astro';

interface Props {
  active: 'overview' | 'qr' | 'pdf' | 'obfuscator' | 'server';
}

const { active } = Astro.props as Props;
const links = [
  { id: 'overview', href: '/tools/', icon: 'grid', label: 'Overview' },
  { id: 'qr', href: '/tools/qr-maker/', icon: 'qr', label: 'QR Code Maker' },
  { id: 'pdf', href: '/tools/pdf-utils/', icon: 'file', label: 'PDF Utils' },
  { id: 'obfuscator', href: '/tools/obfuscator/', icon: 'lock', label: 'Obfuscator' },
  { id: 'server', href: '/tools/server-checker/', icon: 'server', label: 'Server Checker' }
] as const;
---

<button id="nav-burger" class="nav-burger" type="button" aria-label="Open tools menu" aria-controls="tools-sidebar" aria-expanded="false">
  <span class="nav-burger-icon" aria-hidden="true"><Icon name="grid" size={18} /></span>
  <span class="sr-only">Browse tools</span>
</button>
<div id="nav-scrim" class="nav-scrim"></div>
<aside id="tools-sidebar" class="sidebar" aria-label="Tools navigation">
  <span class="sidebar-handle" aria-hidden="true"></span>
  <div class="sidebar-head"><a class="side-brand" href="/"><img src="https://avatars.githubusercontent.com/u/145749961?s=96&v=4" alt="" /><span>I-No-oNe</span></a></div>
  <span class="side-label">Tools</span>
  {links.map((link) => <ToolNavItem href={link.href} icon={link.icon} label={link.label} active={active === link.id} />)}
  <span class="side-label">More</span>
  <ToolNavItem href="/" icon="home" label="Main site" />
  <div class="side-foot"><a class="btn btn-primary side-donate" href="/donate/">☕ Donate</a><ThemeToggle /></div>
</aside>
