---
import ThemeToggle from './ThemeToggle.astro';
import ToolNavItem from './ToolNavItem.astro';
import Icon from './Icon.astro';

interface Props {
  active: 'overview' | 'qr' | 'pdf' | 'obfuscator' | 'server';
}

const { active } = Astro.props as Props;
const links = [
  { id: 'overview', href: '/tools.html', icon: 'grid', label: 'Overview' },
  { id: 'qr', href: '/tools/qr-maker.html', icon: 'qr', label: 'QR Code Maker' },
  { id: 'pdf', href: '/tools/pdf-utils.html', icon: 'file', label: 'PDF Utils' },
  { id: 'obfuscator', href: '/tools/obfuscator.html', icon: 'lock', label: 'Obfuscator' },
  { id: 'server', href: '/tools/server-checker.html', icon: 'server', label: 'Server Checker' }
] as const;
---

<button id="nav-burger" class="nav-burger" type="button" aria-label="Open tools menu" aria-controls="tools-sidebar" aria-expanded="false">
  <img src="https://avatars.githubusercontent.com/u/145749961?s=96&v=4" alt="" />
  <span>Tools</span>
  <span class="nav-burger-lines" aria-hidden="true"><i></i><i></i></span>
</button>
<div id="nav-scrim" class="nav-scrim"></div>
<aside id="tools-sidebar" class="sidebar">
  <div class="sidebar-head"><a class="side-brand" href="/"><img src="https://avatars.githubusercontent.com/u/145749961?s=96&v=4" alt="" /><span>I-No-oNe</span></a><button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close tools menu"><Icon name="close" size={18} /></button></div>
  <span class="side-label">Tools</span>
  {links.map((link) => <ToolNavItem href={link.href} icon={link.icon} label={link.label} active={active === link.id} />)}
  <span class="side-label">More</span>
  <ToolNavItem href="/" icon="home" label="Main site" />
  <div class="side-foot"><a class="btn btn-primary side-donate" href="/donate.html">☕ Donate</a><ThemeToggle /></div>
</aside>
