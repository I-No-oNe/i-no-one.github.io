---
import Icon from './Icon.astro';

interface Props {
  active: 'overview' | 'qr' | 'pdf' | 'obfuscator' | 'server';
  title: string;
  description: string;
}

const { active, title, description } = Astro.props as Props;
const details = {
  overview: { icon: 'grid', label: 'Toolbox' },
  qr: { icon: 'qr', label: 'Browser tool' },
  pdf: { icon: 'file', label: 'Document tool' },
  obfuscator: { icon: 'lock', label: 'Text tool' },
  server: { icon: 'server', label: 'Minecraft tool' }
} as const;
const detail = details[active];
---

<div class="page-head">
  <div class="page-head-main">
    <span class="page-head-icon"><Icon name={detail.icon} size={22} /></span>
    <div><p class="page-kicker">{detail.label}</p><h1>{title}</h1></div>
  </div>
  <p class="page-description">{description}</p>
</div>
