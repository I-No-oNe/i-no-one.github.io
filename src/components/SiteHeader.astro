---
import ActionButton from './ActionButton.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container nav-bar">
    <a href="/#top" class="brand"><img src="https://avatars.githubusercontent.com/u/145749961?s=96&v=4" alt="" class="brand-avatar" width="36" height="36" /><span>I-No-oNe</span></a>
    <nav class="desktop-nav" aria-label="Main navigation"><ul><li><a href="/#projects">Projects</a></li><li><a href="/#frc">FRC</a></li><li><a href="/#tools">Tools</a></li><li><a href="/#contact">Contact</a></li></ul></nav>
    <div class="nav-actions">
      <div class="desktop-actions"><ActionButton href="/addon.html" class="nav-btn">Add-on</ActionButton><ActionButton href="/donate.html" variant="primary" class="nav-btn">☕ Donate</ActionButton></div>
      <ThemeToggle />
      <button id="menu-toggle" class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-nav" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-site-nav" aria-label="Mobile navigation">
    <div class="container"><div class="mobile-menu-panel">
      <div class="mobile-link-grid">
        <a href="/#projects"><span class="mobile-link-main"><span class="mobile-link-icon"><Icon name="code" size={17} /></span>Projects</span><Icon name="arrow" size={15} /></a>
        <a href="/#frc"><span class="mobile-link-main"><span class="mobile-link-icon"><Icon name="tools" size={17} /></span>FRC</span><Icon name="arrow" size={15} /></a>
        <a href="/#tools"><span class="mobile-link-main"><span class="mobile-link-icon"><Icon name="grid" size={17} /></span>Tools</span><Icon name="arrow" size={15} /></a>
        <a href="/#contact"><span class="mobile-link-main"><span class="mobile-link-icon"><Icon name="discord" size={17} /></span>Contact</span><Icon name="arrow" size={15} /></a>
      </div>
      <div class="mobile-menu-actions"><ActionButton href="/addon.html"><Icon name="code" size={16} /> Add-on</ActionButton><ActionButton href="/donate.html" variant="primary"><Icon name="heart" size={16} /> Donate</ActionButton></div>
    </div></div>
  </nav>
</header>
