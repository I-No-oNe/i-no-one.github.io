---
import Icon from './Icon.astro';

interface Props { href: string; icon: 'file' | 'grid' | 'home' | 'lock' | 'qr' | 'server'; label: string; active?: boolean; }
const { href, icon, label, active = false } = Astro.props;
---

<a class:list={['side-link', { active }]} href={href} aria-current={active ? 'page' : undefined}><span class="ico"><Icon name={icon} size={18} /></span><span>{label}</span></a>
