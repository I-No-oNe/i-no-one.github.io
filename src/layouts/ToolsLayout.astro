---
import BaseLayout from './BaseLayout.astro';
import ToolPageHeader from '../components/ToolPageHeader.astro';
import ToolsNavigation from '../components/ToolsNavigation.astro';
import ToolAlert from '../components/ToolAlert.astro';
import '../styles/tools-shell.css';

interface Props {
  active: 'overview' | 'qr' | 'pdf' | 'obfuscator' | 'server';
  title: string;
  description: string;
}
const { active, title, description } = Astro.props;
---

<BaseLayout title={`${title} · I-No-oNe`} description={description}>
  <div class="layout">
    <ToolsNavigation active={active} />
    <main class="content"><div class="content-inner tool-page-enter"><ToolPageHeader active={active} title={title} description={description} /><div class="tool-page-body"><slot /></div></div></main>
  </div>
  <ToolAlert />
  <script>
    const burger = document.querySelector('#nav-burger');
    const burgerLabel = burger?.querySelector('.nav-burger-label');
    const sidebar = document.querySelector<HTMLElement>('.sidebar');
    const scrim = document.querySelector('#nav-scrim');
    const content = document.querySelector<HTMLElement>('.content');
    const mobileBar = document.querySelector<HTMLElement>('.mobile-tools-bar');
    const mobile = window.matchMedia('(max-width: 780px)');
    const setOpen = (open: boolean, restoreFocus = true) => {
      open = open && mobile.matches;
      sidebar?.classList.toggle('open', open);
      scrim?.classList.toggle('open', open);
      burger?.setAttribute('aria-expanded', String(open));
      burger?.setAttribute('aria-label', open ? 'Close tools menu' : 'Open tools menu');
      if (burgerLabel) burgerLabel.textContent = open ? 'Close' : 'Tools';
      document.body.classList.toggle('nav-open', open);
      if (sidebar) {
        sidebar.inert = mobile.matches && !open;
        if (open) {
          sidebar.setAttribute('role', 'dialog');
          sidebar.setAttribute('aria-modal', 'true');
        } else {
          sidebar.removeAttribute('role');
          sidebar.removeAttribute('aria-modal');
        }
      }
      if (content) content.inert = open;
      if (mobileBar) mobileBar.inert = open;
      if (open) sidebar?.querySelector<HTMLElement>('.side-link.active')?.focus({ preventScroll: true });
      else if (restoreFocus) (burger as HTMLElement | null)?.focus({ preventScroll: true });
    };
    setOpen(false, false);
    mobile.addEventListener('change', () => setOpen(false, false));
    burger?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('open')));
    scrim?.addEventListener('click', () => setOpen(false));
    sidebar?.querySelector('.sidebar-close')?.addEventListener('click', () => setOpen(false));
    sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      document.body.classList.add('tool-route-leaving');
      setOpen(false, false);
    }));
    document.addEventListener('keydown', (event) => {
      if (!sidebar?.classList.contains('open')) return;
      if (event.key === 'Escape') setOpen(false);
      if (event.key !== 'Tab') return;
      const items = [...sidebar.querySelectorAll<HTMLElement>('a[href], button')].filter(item => item.getClientRects().length);
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    const alertElement = document.querySelector<HTMLElement>('#tool-alert');
    const alertMessage = document.querySelector<HTMLElement>('#tool-alert-message');
    const alertClose = document.querySelector<HTMLButtonElement>('#tool-alert-close');
    let alertTimer = 0;
    const hideToolAlert = () => {
      alertElement?.classList.remove('show');
      window.clearTimeout(alertTimer);
      window.setTimeout(() => { if (alertElement && !alertElement.classList.contains('show')) alertElement.hidden = true; }, 320);
    };
    window.showToolAlert = (message: string, type: 'error' | 'success' = 'error') => {
      if (!alertElement || !alertMessage) return;
      window.clearTimeout(alertTimer);
      alertMessage.textContent = message;
      alertElement.dataset.type = type;
      alertElement.hidden = false;
      requestAnimationFrame(() => alertElement.classList.add('show'));
      alertTimer = window.setTimeout(hideToolAlert, 3600);
    };
    alertClose?.addEventListener('click', hideToolAlert);
  </script>
</BaseLayout>
