---
import BaseLayout from './BaseLayout.astro';
import ToolsNavigation from '../components/ToolsNavigation.astro';
import shellStyles from '../styles/tools-shell.css?url';

interface Props {
  active: 'overview' | 'qr' | 'pdf' | 'obfuscator' | 'server';
  title: string;
  description: string;
  stylesheets?: string[];
}
const { active, title, description, stylesheets = [] } = Astro.props;
---

<BaseLayout title={`${title} · I-No-oNe`} description={description}>
  <Fragment slot="head">{stylesheets.map((href) => <link rel="stylesheet" href={href} />)}<link rel="stylesheet" href={shellStyles} /></Fragment>
  <div class="layout">
    <ToolsNavigation active={active} />
    <main class="content"><div class="content-inner rise"><div class="page-head"><h1>{title}</h1><p>{description}</p></div><slot /></div></main>
  </div>
  <script>
    const burger = document.querySelector('#nav-burger');
    const sidebar = document.querySelector('.sidebar');
    const scrim = document.querySelector('#nav-scrim');
    const setOpen = (open: boolean) => {
      sidebar?.classList.toggle('open', open);
      scrim?.classList.toggle('open', open);
      burger?.setAttribute('aria-expanded', String(open));
      burger?.setAttribute('aria-label', open ? 'Close tools menu' : 'Open tools menu');
      document.body.classList.toggle('nav-open', open);
    };
    burger?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('open')));
    scrim?.addEventListener('click', () => setOpen(false));
    sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !sidebar?.classList.contains('open')) return;
      setOpen(false);
      (burger as HTMLElement | null)?.focus();
    });
  </script>
</BaseLayout>
